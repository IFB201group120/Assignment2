# Copy this file to .env.local and fill in the values from YOUR Salesforce org.
# All four values must come from the SAME org.
#
# None of these carry the NEXT_PUBLIC_ prefix. That prefix is what inlines a
# value into the browser bundle — adding it to SF_CONSUMER_SECRET would publish
# your org credential to every visitor.

SF_MY_DOMAIN_URL=
SF_API_BASE=https://api.salesforce.com
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_AGENT_ID=
